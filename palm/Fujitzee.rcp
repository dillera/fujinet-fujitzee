#include "FujitzeeRsc.h"

VERSION ID 1 "0.1"

ICONFAMILYEX
BEGIN
    BITMAP "icon.bmp" BPP 1
END

FORM ID SetupForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID SetupMenu
BEGIN
    TITLE "FN Fujitzee"
    LABEL "Name:" AUTOID AT (2 17)
    FIELD ID SetupNameField AT (38 17 50 12) UNDERLINED SINGLELINE MAXCHARS 8
    LABEL "Server:" AUTOID AT (2 31)
    FIELD ID SetupServerField AT (38 31 120 12) UNDERLINED SINGLELINE MAXCHARS 63
    LABEL "Tables" AUTOID AT (2 46) FONT 1
    BUTTON "Refresh" ID SetupRefreshButton AT (118 45 40 12) FONT 0
    LIST "" ID SetupList AT (2 59 156 66) VISIBLEITEMS 6
    LABEL "Table:" AUTOID AT (2 130)
    FIELD ID SetupTableField AT (38 130 50 12) UNDERLINED SINGLELINE MAXCHARS 8
    BUTTON "Sit Down" ID SetupSitButton AT (1 147 AUTO AUTO)
    FIELD ID SetupStatusField AT (50 148 96 11) NONEDITABLE SINGLELINE MAXCHARS 47
    GRAFFITISTATEINDICATOR AT (150 148)
END

FORM ID TableForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID TableMenu
BEGIN
END

MENU ID SetupMenu
BEGIN
    PULLDOWN "Game"
    BEGIN
        MENUITEM "Refresh Tables" ID SetupMenuRefresh "R"
        MENUITEM "Default Server" ID SetupMenuDefault
        MENUITEM SEPARATOR
        MENUITEM "About" ID SetupMenuAbout
    END
END

MENU ID TableMenu
BEGIN
    PULLDOWN "Table"
    BEGIN
        MENUITEM "Leave Table" ID TableMenuLeave "L"
        MENUITEM "Scores" ID TableMenuScores "S"
        MENUITEM "How to Play" ID TableMenuHelp "H"
        MENUITEM SEPARATOR
        MENUITEM "About" ID TableMenuAbout
    END
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
    TITLE "FN Fujitzee"
    MESSAGE "This app needs Palm OS 3.3 or later."
    BUTTONS "OK"
END

ALERT ID MessageAlert
ERROR
BEGIN
    TITLE "FN Fujitzee"
    MESSAGE "^1^2^3"
    BUTTONS "OK"
END

ALERT ID ScoresAlert
INFORMATION
BEGIN
    TITLE "Scores"
    MESSAGE "^1^2^3"
    BUTTONS "OK"
END

ALERT ID HelpAlert
INFORMATION
BEGIN
    TITLE "How to Play"
    MESSAGE "On your turn the dice are rolled for you. Tap dice to hold them (held dice turn black), then tap Roll; you get two re-rolls.\n\nTap a row to pick it, then tap it again or tap Take to score it. Upper rows worth 63 or more earn a 35 point bonus.\n\nKeys: scroll keys pick a row, Date Book rolls, the other app buttons take the row. Graffiti 1-5 hold a die, r rolls."
    BUTTONS "OK"
END

ALERT ID AboutAlert
INFORMATION
BEGIN
    TITLE "FN Fujitzee"
    MESSAGE "Multiplayer Fujitzee, a Yahtzee-style dice game, against the Fujitzee server through FujiNet's N1: device.\n\nThe same tables as the Atari, Apple II, CoCo, Adam and cartridge clients of fujinet-fujitzee (GPL-3.0)."
    BUTTONS "OK"
END
